# Database Configuration
DATABASE_URL=database-url
SESSION_SECRET=session-secret

# Storage Configuration
# Options: local | s3-glacier
# For local development: STORAGE_DRIVER=local
# For production migration: STORAGE_DRIVER=s3-glacier
STORAGE_DRIVER=local

# AWS S3 + Glacier Configuration (for production)
# Required only when STORAGE_DRIVER=s3-glacier
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=grwofinance-glacier-policy
AWS_GLACIER_VAULT_NAME=grwofinance-glacier-vault
AWS_ACCOUNT_ID=your_aws_account_id_here

# Paystack Configuration (optional)
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Application Configuration
NODE_ENV=development
PORT=5000
